UPSTREAM_URL=
# 多条链路可用逗号 / 分号 / 换行分隔；代理会在重试窗口内随机切换链路
# UPSTREAM_URLS=https://open.juece.cloud/v1;https://your-second-endpoint.example/v1
UPSTREAM_API_KEY=
# NEWAPI -> 本项目的独立入口鉴权 Key，和客户端 Key、上游模型 Key 都无关；多 Key 可用逗号/分号/换行分隔
# 也可在控制台“入口鉴权”生成 sk- 开头的托管 Key；托管 Key 会随运行配置持久化，本变量可留空
PROXY_API_KEYS=
# 客户端模型名=上游模型名；多条可用分号分隔，控制台里也可以多行编辑。留空会回落到内置 DeepSeek 默认映射。
MODEL_ALIASES=deepseek-v4-flash=deepseek-ai/deepseek-v4-flash;deepseek-v4-pro=deepseek-ai/deepseek-v4-pro
ENABLE_MODEL_PROBE=1
MODEL_PROBE_TIMEOUT_SECONDS=4
MODEL_PROBE_TTL_SECONDS=300
MODEL_ROUTE_CACHE_TTL_SECONDS=86400
ENABLE_MODEL_CANDIDATE_RACE=1
MODEL_CANDIDATE_RACE_LIMIT=3
MODEL_CANDIDATE_RACE_TIMEOUT_SECONDS=8
PROXY_CONFIG_PATH=config/proxy-config.json
PROXY_LOG_PATH=var/logs/proxy.log
SQLITE_DB_PATH=var/cache/proxy-cache.sqlite3
MODEL_ROUTE_CACHE_PATH=var/cache/model-route-cache.json
PORT=18765
# --- 管理面板认证（部署后务必修改默认密码）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# --- MySQL 持久化（可选；为空时仅使用本地文件/内存存储）---
# 容器与 MySQL 位于同一 Docker 网络时，推荐 STORAGE_DB_HOST=mysql
STORAGE_DB_HOST=
STORAGE_DB_PORT=3306
STORAGE_DB_USER=
STORAGE_DB_PASSWORD=
STORAGE_DB_NAME=
SHARED_DOCKER_NETWORK=1panel-network
HOST_GATEWAY_HOSTNAME=host.docker.internal
HOST_GATEWAY_ADDRESS=host-gateway
# --- 远程部署信息（本地 .env 可填写；不要提交私钥正文）---
DEPLOY_SSH_HOST=
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=
DEPLOY_SSH_KEY_PATH=
DEPLOY_REMOTE_PATH=
# --- 远程 MySQL 持久化（deploy-remote.ps1 用于同步服务器 .env）---
DEPLOY_STORAGE_DB_HOST=
DEPLOY_STORAGE_DB_PORT=3306
DEPLOY_STORAGE_DB_USER=
DEPLOY_STORAGE_DB_PASSWORD=
DEPLOY_STORAGE_DB_NAME=
# --- 多目标部署（可与上面的单目标变量并存）---
# DEPLOY_TARGETS=legacy,baota
# DEPLOY_LEGACY_SSH_HOST=122.51.64.95
# DEPLOY_LEGACY_SSH_PORT=22
# DEPLOY_LEGACY_SSH_USER=root
# DEPLOY_LEGACY_SSH_AUTH_MODE=key
# DEPLOY_LEGACY_SSH_KEY_PATH=C:/Users/Administrator/.ssh/juece_root_ed25519
# DEPLOY_LEGACY_REMOTE_PATH=/root/local-proxy
# DEPLOY_LEGACY_SERVICE_NAME=local-proxy
# DEPLOY_LEGACY_APP_PORT=18765
# DEPLOY_LEGACY_SHARED_DOCKER_NETWORK=1panel-network
# DEPLOY_LEGACY_STORAGE_DB_HOST=mysql
# DEPLOY_LEGACY_STORAGE_DB_PORT=3306
# DEPLOY_LEGACY_STORAGE_DB_USER=
# DEPLOY_LEGACY_STORAGE_DB_PASSWORD=
# DEPLOY_LEGACY_STORAGE_DB_NAME=
# DEPLOY_BAOTA_SSH_HOST=154.36.185.70
# DEPLOY_BAOTA_SSH_PORT=22
# DEPLOY_BAOTA_SSH_USER=root
# DEPLOY_BAOTA_SSH_AUTH_MODE=password
# DEPLOY_BAOTA_SSH_PASSWORD=
# DEPLOY_BAOTA_REMOTE_PATH=/root/local-proxy
# DEPLOY_BAOTA_SERVICE_NAME=local-proxy
# DEPLOY_BAOTA_APP_PORT=18765
# DEPLOY_BAOTA_SHARED_DOCKER_NETWORK=local-proxy-shared
# DEPLOY_BAOTA_STORAGE_DB_HOST=mysql
# DEPLOY_BAOTA_STORAGE_DB_PORT=3306
# DEPLOY_BAOTA_STORAGE_DB_USER=
# DEPLOY_BAOTA_STORAGE_DB_PASSWORD=
# DEPLOY_BAOTA_STORAGE_DB_NAME=
REQUEST_TIMEOUT=600
SSE_HEARTBEAT_SECONDS=12
STREAM_OPEN_GRACE_SECONDS=1.5
STREAM_FIRST_EVENT_TIMEOUT_SECONDS=6
STREAM_ROUTE_SWITCH_CONNECT_TIMEOUT_SECONDS=6
MAX_COMPLETION_TOKENS=0
MODEL_CAPABILITIES=deepseek-v4-flash=1048576,393216;deepseek-v4-pro=1048576,393216;gpt-5.5=1000000,128000;gpt-5.4=1000000,128000;claude-opus-4-7=1000000,128000;claude-opus-4-6=1000000,128000
FORCE_UPSTREAM_CHAT_STREAM=1
ENABLE_REQUEST_NORMALIZATION=1
INJECT_ZH_SYSTEM_PROMPT=1
# PROXY_SYSTEM_PROMPT_ZH=自定义中文系统提示
UPSTREAM_MAX_RETRIES=12
UPSTREAM_RETRY_BACKOFF_MS=1200
UPSTREAM_RETRY_MAX_BACKOFF_MS=6000
UPSTREAM_ROUTE_SWITCH_WINDOW_SECONDS=60
UPSTREAM_RANDOMIZE_ENDPOINTS=1
IMAGE_UPSTREAM_PROTOCOL=auto
IMAGE_TASK_POLL_TIMEOUT_SECONDS=90
IMAGE_TASK_POLL_INTERVAL_SECONDS=2
